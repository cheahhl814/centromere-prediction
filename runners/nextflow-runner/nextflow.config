// nf-centromere-agents — Nextflow configuration
// No logic here. Only params, profiles, and resources.

params {
    reads    = ""
    assembly = ""
    outdir   = "results"
}

// Resource defaults (applied to all profiles unless overridden)
process {
    withLabel: 'centromere' {
        cpus   = 24
        memory = '96 GB'
        time   = 24.h
    }
}

profiles {
    local {
        process {
            executor = 'local'
        }
    }
    slurm {
        process {
            executor = 'slurm'
            queue    = 'cpu1,cpu2'
            withLabel: 'centromere' {
                clusterOptions = '--partition=cpu1,cpu2 --job-name=centromere --ntasks=1 --ntasks-per-node=1 --mem=96G --cpus-per-task=24 -o test.out -e test.err'
                cpus = 24
                memory = '96 GB'
            }
        }
    }
}

// Trace and reporting
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
