// Test profile: stub-run everything against the deterministic fixtures in test-data/
params {
    reads    = "${projectDir}/../../test-data/reads.fastq.gz"
    assembly = "${projectDir}/../../test-data/ref.fasta"
}

process {
    withLabel: 'centromere' {
        cpus = 2
        memory = '2 GB'
    }
}
