// test_sat profile: a REAL (non-stub) run on the satellite fixture — monomers are found, ranked,
// capped and decomposed, so every process executes on non-empty data. Run:
//   nextflow run main.nf -profile test_sat
params {
    reads         = "${projectDir}/../../test-data/sat_reads.fastq.gz"
    assembly      = "${projectDir}/../../test-data/sat_ref.fasta"
    max_monomers  = 5
    region_window = 100000
}

process {
    withLabel: 'centromere' {
        cpus = 2
        memory = '4 GB'
    }
}
